    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "1.3.7",
    "date-fns": "3.6.0",
    "date-fns-tz": "2.0.1",
    "framer-motion": "11.18.2",
    "next": "14.2.35",
    "next-themes": "0.4.6",
    "react": "18.3.1",
    "react-day-picker": "8.10.2",
    "react-dom": "18.3.1",
    "react-icons": "5.7.0",
    "sonner": "1.7.4",
    "ts-pattern": "5.9.0"
  },
  "devDependencies": {
    "@hayabusa/core": "workspace:*",
